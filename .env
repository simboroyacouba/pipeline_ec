# ============================================================
# Pipeline Toitures — variables d'environnement
# ============================================================

# ── YOLO détection oblique (class/yolo_classification) ──────
# Utilisé pour les images Snapshot (vue oblique)
YOLO_DET_OBLIQUE_MODEL=C:/Users/NEBRATA/Downloads/final/class/yolo_classification/runs/detect/oblique/train/weights/best.pt

# ── YOLO détection nadir (class/yolo_classification) ────────
# Utilisé pour les images Production (vue nadir/ortho)
YOLO_DET_NADIR_MODEL=C:/Users/NEBRATA/Downloads/final/class/yolo_classification/runs/detect/nadir/train/weights/best.pt

FASTER_DET_OBLIQUE_MODEL=C:/Users/NEBRATA/Downloads/final/class/fasterrcnn_classification/runs/detect/train/oblique/fasterrcnn_oblique/best_model.pth
FASTER_DET_NADIR_MODEL=C:/Users/NEBRATA/Downloads/final/class/fasterrcnn_classification/runs/detect/train/nadir/fasterrcnn_nadir/best_model.pth

# ── YOLO segmentation (seg/yolo) ────────────────────────────
# Utilisé dans l'ensemble Soft+WA-NMS (Production uniquement)
YOLO_SEG_MODEL=C:/Users/NEBRATA/Downloads/final/seg/yolo/runs/segment/output/train/weights/best.pt

# ── Mask R-CNN (seg/mark_r_cnn) ─────────────────────────────
MASKRCNN_MODEL=C:/Users/NEBRATA/Downloads/final/seg/mark_r_cnn/output/best_model.pth

# ── DeepLabV3+ (seg/DeepLabV3) ──────────────────────────────
DEEPLAB_MODEL=C:/Users/NEBRATA/Downloads/final/seg/DeepLabV3/output/best_model.pth
DEEPLAB_BACKBONE=resnet50

# ── Seuil de confiance global (fallback si classe non définie) ─
SCORE_THRESHOLD=0.15

# ── Seuils de confiance par classe — YOLO ────────────────────
YOLO_CONF_PANNEAU_SOLAIRE=0.15
YOLO_CONF_BATIMENT_PEINT=0.30
YOLO_CONF_BATIMENT_NON_ENDUIT=0.30
YOLO_CONF_BATIMENT_ENDUIT=0.30
YOLO_CONF_MENUISERIE_METALLIQUE=0.30

# ── Seuils de confiance par classe — Faster R-CNN ────────────
FRCNN_CONF_PANNEAU_SOLAIRE=0.40
FRCNN_CONF_BATIMENT_PEINT=0.30
FRCNN_CONF_BATIMENT_NON_ENDUIT=0.30
FRCNN_CONF_BATIMENT_ENDUIT=0.30
FRCNN_CONF_MENUISERIE_METALLIQUE=0.30

# ── Seuils de confiance par classe — fusion post-WA-NMS ──────
# Scores pondérés (max = score_brut × 0.55), ex. brut 0.30 → pondéré 0.165
CONF_PANNEAU_SOLAIRE=0.17
CONF_BATIMENT_PEINT=0.30
CONF_BATIMENT_NON_ENDUIT=0.30
CONF_BATIMENT_ENDUIT=0.30
CONF_MENUISERIE_METALLIQUE=0.30

# ── Seuils de confiance par classe — segmentation ────────────
# Utilisés par YOLOSegDetector, MaskRCNNDetector, SoftWANMSEnsemble
CONF_TOITURE_TOLE_ONDULEE=0.30
CONF_TOITURE_TOLE_BAC=0.30
CONF_TOITURE_DALLE=0.30

OUTPUT_DIR=C:/Users/NEBRATA/Downloads/final/pipeline/output

# ── Résolution de l'image (ortho/drone) ─────────────────────
# GSD : Ground Sampling Distance — mètres par pixel
# Formule : superficie_m2 = mask_area_px * RESOLUTION_M_PX^2
# Exemples courants :
#   0.05  →  5 cm/px  (drone haute résolution)
#   0.10  → 10 cm/px  (drone standard)
#   0.20  → 20 cm/px  (ortho satellitaire HR)
#   0.50  → 50 cm/px  (ortho satellitaire standard)
# RESOLUTION_M_PX=0.02
RESOLUTION_M_PX=0.027

# ── Valeurs par défaut des caractéristiques bâtiment ────────
# Utilisées quand le modèle ne détecte pas la valeur explicitement
DEFAULT_TYPE_COUVERTURE=Tôle bac
DEFAULT_MATERIAUX_CONSTRUCTION=Définitifs
DEFAULT_AMENAGEMENT_FACADE=Enduit
DEFAULT_MENUISERIE_FACADE=Aluminium

# ── Mapping classes modèle → caractéristiques bâtiment ──────
# Fichier JSON qui définit quelles classes du modèle correspondent
# à chaque caractéristique (type_couverture, materiaux_construction, etc.)
CLASS_MAPPING_FILE=C:/Users/NEBRATA/Downloads/final/pipeline/class_mapping.json
CATEGORIES_FILE=C:/Users/NEBRATA/Downloads/final/pipeline/categories_batiments.json

# ── Tarification ─────────────────────────────────────────────
# Prix d'un panneau solaire en francs CFA
PRIX_PANNEAU_SOLAIRE_FCFA=75000
